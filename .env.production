# Build-time public values for CI builds (Cloudflare Workers Builds has no .env.local).
# VAPID public key is public by design — it ships inside the client bundle.
NEXT_PUBLIC_SITE_URL=https://sharemoney.cc
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BGvOAgREiZw86VpRNxX7YAm99dx0Nhj-y3_4RkZ9s7V42reB95lVJul43FDYKX5KPNxLF2pslRZ0h-GgoFY3TBM
# AdSense publisher id (ca-pub-…). Empty = no ad script, /ads.txt returns 404.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-8862517332076590
# Display ad unit id from the AdSense dashboard (the data-ad-slot number).
# Empty = <AdUnit> renders nothing, so the site loads the AdSense script but shows
# zero ad slots — which is what a reviewer sees as "no ads to review".
NEXT_PUBLIC_ADSENSE_SLOT=
